{
  "name": "fub-mcp",
  "version": "0.1.0",
  "description": "A comprehensive Model Context Protocol (MCP) server wrapping the Follow Up Boss (FUB) real estate CRM API.",
  "type": "module",
  "bin": {
    "fub-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "skills",
    "claude-setup",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "followupboss",
    "fub",
    "crm",
    "real-estate",
    "claude"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
