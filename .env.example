# Your personal Follow Up Boss API key (Admin > API in FUB, or ask your account admin).
# Sent as HTTP Basic auth: Authorization: Basic base64("<key>:")
FUB_API_KEY=

# Optional: identifies this tool to FUB's API for better rate limits and attribution.
# Leave as-is unless you've registered your own system at https://followupboss.com/2/api
FUB_MCP_SYSTEM_NAME=fub-mcp
FUB_MCP_SYSTEM_KEY=

# Set to 1 to allow DELETE-verb tools to be registered at all. Off by default.
# Even when set, every delete tool also requires an explicit confirm=true argument
# per call, and the model is instructed to get your explicit sign-off first.
FUB_MCP_ALLOW_DELETE=0
