# Set these through the MCP host's protected environment settings.
# A project-root .env is NOT automatically loaded. Never commit real keys.
FUB_API_KEY=

# Default: View information. Set to 1 (or true) for View and update records.
FUB_MCP_ALLOW_WRITE=0

# Advanced, separate permissions. Each also needs ALLOW_WRITE=1.
FUB_MCP_ALLOW_DELETE=0
FUB_MCP_ALLOW_WEBHOOKS=0
FUB_MCP_ALLOW_AUTOMATIONS=0
# Exact HTTPS hostnames for new/changed webhook destinations, comma-separated.
# No wildcards, URLs, IPs, credentials, fragments or non-443 ports.
FUB_MCP_WEBHOOK_HOSTS=

# Optional matching registered system identity. Never publish either key.
FUB_MCP_SYSTEM_NAME=
FUB_MCP_SYSTEM_KEY=
